# ── Old local blog URLs → live blog (301, permanent) ─────────────────
# Blogs now live at https://blog.supershyft.com/ (not /blog/ on this host).
RewriteEngine On
RewriteRule ^blogs\.html$ https://blog.supershyft.com/ [R=301,L]
RewriteRule ^blog/?$ https://blog.supershyft.com/ [R=301,L]
RewriteRule ^blog/ https://blog.supershyft.com/ [R=301,L]
