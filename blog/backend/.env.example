DB_HOST=localhost
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASS=your_db_password

SITE_URL=https://www.supershyft.com
FRONTEND_URL=https://www.supershyft.com

ADMIN_EMAIL=admin@supershyft.com
ADMIN_PASS=change_me_in_production

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional: From shown on outgoing mail. MAIL_FROM defaults to SMTP_USER.
# On Hostinger MAIL_FROM should equal the authenticated SMTP_USER mailbox.
MAIL_FROM=
MAIL_FROM_NAME=Supershyft
# Where contact-form leads are emailed. Defaults to SMTP_USER.
CONTACT_TO=hello@supershyft.com

DEBUG=false
